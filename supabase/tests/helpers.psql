-- Helpers de teste (funcionam no shim local e no Supabase real).
-- Incluir com: \ir helpers.psql  (dentro de uma transação).
create schema if not exists tests;
grant usage on schema tests to authenticated, anon;

create or replace function tests.create_user(nome text) returns uuid
language plpgsql as $$
declare v_id uuid;
begin
  insert into auth.users (id, aud, role, email, raw_user_meta_data)
  values (gen_random_uuid(), 'authenticated', 'authenticated',
          nome || '@teste.local', jsonb_build_object('nome', nome))
  returning id into v_id;
  return v_id;
end $$;

create or replace function tests.uid(nome text) returns uuid
language sql stable security definer set search_path = auth, pg_catalog as $$
  select id from auth.users where email = nome || '@teste.local'
$$;
grant execute on function tests.uid(text) to authenticated, anon;

create or replace function tests.clear_auth() returns void
language plpgsql as $$
begin
  reset role;
  perform set_config('request.jwt.claims', '', true);
end $$;
grant execute on function tests.clear_auth() to authenticated, anon;

create or replace function tests.authenticate_as(nome text) returns void
language plpgsql as $$
declare v_uid uuid := tests.uid(nome);
begin
  if v_uid is null then raise exception 'usuario de teste % inexistente', nome; end if;
  reset role;
  perform set_config('request.jwt.claims',
    json_build_object('sub', v_uid, 'role', 'authenticated')::text, true);
  set role authenticated;
end $$;
grant execute on function tests.authenticate_as(text) to authenticated, anon;
