# Públicas (vão para o navegador). Nunca coloque service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Login com Google (lidas pelo Supabase Auth via supabase/config.toml; NÃO são públicas, nunca use NEXT_PUBLIC_).
# Crie as credenciais OAuth no Google Cloud Console e exporte antes de `supabase start`.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
